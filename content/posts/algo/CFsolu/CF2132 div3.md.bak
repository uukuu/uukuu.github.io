## B

### code

```cpp
int T;
ll n,a[20],tot;
int main()
{
	read(T);
	while(T--)
	{
		read(n);
      ll p=1;
		tot=0;
		for(int i=1;i<=18;i++)
		{
			p*=10;
			if(p+1>n)break;
			if(n%(p+1)==0)a[++tot]=n/(p+1);
		}
		reverse(a+1,a+tot+1);
		write(tot);
		for(int i=1;i<=tot;i++)write(a[i],i<tot?' ':'\n');
	}
    flushout();
    return 0;
}
```

